# Postgres configs
PG_HOST=
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=
PG_SSL=false

# Better Auth configs
ORIGIN=http://localhost:5173
ORIGIN_DEV=http://localhost:5173
BETTER_AUTH_SECRET=your_very_long_secret_key_at_least_32_characters_long_here

# AI and tools
OPENROUTER_API_KEY=
# Verified working values against https://openrouter.ai/api/v1
REASONING_MODEL=google/gemma-4-31b-it
EMBEDDING_MODEL=openai/text-embedding-3-small

# Server configs
BODY_SIZE_LIMIT=100M